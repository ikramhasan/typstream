#show: worksheet.with(
  title: [Past Tense Verbs],
  subject: [English],
  grade: [Grade 4],
  instructions: [Answer all questions. Remember: most past tense verbs end in *-ed*, but some are irregular.],
)

#callout(kind: "remember")[
  A *past tense verb* tells us about something that already happened.
  - Regular verbs add *-ed*: walk #sym.arrow walked, jump #sym.arrow jumped.
  - Irregular verbs change in other ways: go #sym.arrow went, eat #sym.arrow ate.
]

= Part A: Fill in the blanks

#question(points: 5)[
  Write the past tense of the verb in brackets.
  + Yesterday, we #blank(answer: [played]) football at the park. (play)
  + Mia #blank(answer: [ate]) an apple for lunch. (eat)
  + The dog #blank(answer: [jumped]) over the fence. (jump)
  + Last week, I #blank(answer: [went]) to my grandmother's house. (go)
  + The children #blank(answer: [watched]) a film on Saturday. (watch)
]

= Part B: Matching

#question(points: 6)[
  Match each present tense verb with its past tense form.
  #matching(
    ([run], [ran]),
    ([see], [saw]),
    ([write], [wrote]),
    ([swim], [swam]),
    ([bring], [brought]),
    ([take], [took]),
  )
]

= Part C: Choose the correct verb

#question(points: 2)[
  Which sentence is correct?
  #mcq(
    [She goed to school by bus.],
    [She went to school by bus.],
    [She gone to school by bus.],
    answer: 2,
  )
]

#question(points: 2)[
  #true-false(answer: true)[The past tense of "cook" is "cooked".]
  #true-false(answer: false)[The past tense of "drink" is "drinked".]
]

= Part D: Short writing

#question(points: 5)[
  Write three or four sentences about what you did last weekend. Use at least *three* past tense verbs and underline them.
  #answer-lines(count: 5, answer: [Sample: On Saturday I visited my cousins. We played games and ate pizza. On Sunday I helped my mum cook dinner.])
]

