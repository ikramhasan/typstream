#show: worksheet.with(
  title: [Solving Linear Equations],
  subject: [Mathematics],
  grade: [Grade 8],
  instructions: [Solve each equation for $x$. Show every step in the working space. Questions get harder as you go.],
)

= Part A: One- and two-step equations

#question(points: 1)[
  Solve $x + 7 = 12$. Give $x =$ #blank(answer: [5]).
]

#question(points: 1)[
  Solve $4x = 28$.
  #answer-space(height: 2.5em, answer: [$x = 7$])
]

#question(points: 1)[
  Solve $x / 3 = 6$.
  #answer-space(height: 2.5em, answer: [$x = 18$])
]

#question(points: 2)[
  Solve $2x + 5 = 17$. Show your working.
  #answer-space(height: 4em, answer: [$2x = 12$, so $x = 6$.])
]

#question(points: 2)[
  Solve $3x - 8 = 13$, then check your answer by substituting it back into the equation.
  #answer-space(height: 5em, answer: [$3x = 21$, so $x = 7$. Check: $3(7) - 8 = 13$. ✓])
]

= Part B: Unknowns on both sides and brackets

#question(points: 2)[
  Solve $5x - 3 = 2x + 9$.
  #answer-space(height: 5em, answer: [$3x = 12$, so $x = 4$.])
]

#question(points: 2)[
  Solve $3(x + 4) = 27$.
  #answer-space(height: 5em, answer: [$x + 4 = 9$, so $x = 5$.])
]

#question(points: 3)[
  Solve $2(3x - 1) = 4x + 10$.
  #answer-space(height: 6em, answer: [$6x - 2 = 4x + 10$, so $2x = 12$ and $x = 6$.])
]

#question(points: 3)[
  Solve each equation.
  + $x / 2 + 3 = 7$
    #answer-lines(count: 1, answer: [$x = 8$])
  + $(2x + 1) / 5 = 3$
    #answer-lines(count: 1, answer: [$2x + 1 = 15$, so $x = 7$])
  + $4 - (x - 6) = 9$
    #answer-lines(count: 1, answer: [$4 - x + 6 = 9$, so $10 - x = 9$ and $x = 1$])
]

= Part C: Challenge

#question(points: 3)[
  Solve $(x + 3) / 2 - (x - 1) / 4 = 3$. Hint: multiply both sides by 4 first.
  #answer-space(height: 7em, answer: [$2(x + 3) - (x - 1) = 12$, so $x + 7 = 12$ and $x = 5$.])
]

#question(points: 3)[
  A number is multiplied by 3, then 9 is added. The result is 33. Write an equation and find the number.
  #answer-space(height: 5em, answer: [$3n + 9 = 33$, so $3n = 24$ and $n = 8$.])
]

#question(points: 4)[
  Explain why $x + 2 = x + 5$ has no solution.
  #answer-lines(count: 3, answer: [Subtracting $x$ from both sides leaves $2 = 5$, which is false for every value of $x$, so no value of $x$ makes the equation true.])
]