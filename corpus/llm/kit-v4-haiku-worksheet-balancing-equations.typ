#show: worksheet.with(
  title: [Balancing Chemical Equations],
  subject: [Chemistry],
  grade: [Grade 9],
  info: ("name", "class", "roll"),
  instructions: [Balance each equation by changing only the coefficients (the numbers in front). Never change the subscripts. Questions get harder as you go.],
)

#callout(kind: "tip")[
  Balance metals and non-metals first, then oxygen, then hydrogen. Count the atoms of each element on both sides before you finish.
]

= Part A: Introductory

#question(points: 1)[
  Balance: #ce("H2 + O2 -> H2O")
  #answer-lines(count: 1, answer: ce("2H2 + O2 -> 2H2O"))
]

#question(points: 1)[
  Balance: #ce("Na + Cl2 -> NaCl")
  #answer-lines(count: 1, answer: ce("2Na + Cl2 -> 2NaCl"))
]

#question(points: 1)[
  Balance: #ce("Mg + O2 -> MgO")
  #answer-lines(count: 1, answer: ce("2Mg + O2 -> 2MgO"))
]

= Part B: Intermediate

#question(points: 2)[
  Balance: #ce("CH4 + O2 -> CO2 + H2O")
  #answer-lines(count: 1, answer: ce("CH4 + 2O2 -> CO2 + 2H2O"))
]

#question(points: 2)[
  Balance: #ce("Al + O2 -> Al2O3")
  #answer-lines(count: 1, answer: ce("4Al + 3O2 -> 2Al2O3"))
]

#question(points: 2)[
  Balance: #ce("Fe + O2 -> Fe2O3")
  #answer-lines(count: 1, answer: ce("4Fe + 3O2 -> 2Fe2O3"))
]

= Part C: Challenge

#question(points: 2)[
  Balance: #ce("C3H8 + O2 -> CO2 + H2O")
  #answer-lines(count: 1, answer: ce("C3H8 + 5O2 -> 3CO2 + 4H2O"))
]

#question(points: 2)[
  Balance: #ce("Ca(OH)2 + H3PO4 -> Ca3(PO4)2 + H2O")
  #answer-lines(count: 1, answer: ce("3Ca(OH)2 + 2H3PO4 -> Ca3(PO4)2 + 6H2O"))
]

#question(points: 3)[
  Balance: #ce("KMnO4 + HCl -> KCl + MnCl2 + H2O + Cl2")
  #answer-lines(count: 1, answer: ce("2KMnO4 + 16HCl -> 2KCl + 2MnCl2 + 8H2O + 5Cl2"))
]

#question(points: 2)[
  Balance: #ce("Al + H2SO4 -> Al2(SO4)3 + H2")
  #answer-lines(count: 1, answer: ce("2Al + 3H2SO4 -> Al2(SO4)3 + 3H2"))
]

#answer-key()