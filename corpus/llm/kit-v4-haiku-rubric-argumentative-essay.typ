#show: worksheet.with(title: [Argumentative Essay Rubric], subject: [English Language Arts], grade: [Grade 11], info: none)

#instructions[
  Each criterion is scored on four levels. The points for each level are shown in the table; the total is out of 10.
]

#rubric(
  ([Thesis], [Clear, arguable claim stated early and sustained throughout the essay.], [Clear claim, though it weakens or drifts in places.], [Claim is present but vague or hard to identify.], [No identifiable claim.]),
  ([Evidence], [Strong, relevant, and cited evidence from several credible sources.], [Relevant evidence, with some sources cited.], [Limited or weakly relevant evidence; sources rarely cited.], [No evidence, or evidence that does not support the claim.]),
  ([Reasoning], [Each piece of evidence is explained and linked to the claim; counterarguments are addressed fairly.], [Most evidence is explained; counterarguments are mentioned.], [Evidence is mostly listed rather than explained.], [No reasoning connects evidence to the claim.]),
  ([Organization and style], [Logical structure with smooth transitions; precise, formal language with no errors that affect meaning.], [Generally logical structure; occasional lapses in transitions or word choice.], [Structure is hard to follow; frequent errors in grammar or word choice.], [No discernible structure; errors obscure meaning.]),
  levels: ([Excellent], [Proficient], [Developing], [Beginning]),
  points: (2.5, 2, 1, 0.5),
)