#show: quiz.with(
  title: [Cell Biology: True or False],
  subject: [Biology],
  grade: [Grade 9],
  instructions: [Read each statement and mark it *True* or *False*.],
)

#question(points: 1)[
  #true-false(answer: true)[The nucleus contains the cell's genetic material (DNA).]
]

#question(points: 1)[
  #true-false(answer: false)[Both plant cells and animal cells have a cell wall.]
  #answer[False. Only plant cells (and fungi and bacteria) have a cell wall.]
]

#question(points: 1)[
  #true-false(answer: true)[Mitochondria are the site of most ATP production in aerobic respiration.]
]

#question(points: 1)[
  #true-false(answer: true)[Ribosomes are where proteins are made.]
]

#question(points: 1)[
  #true-false(answer: false)[Chloroplasts are found in animal cells.]
  #answer[False. Chloroplasts are found in plant cells and algae, where photosynthesis takes place.]
]

#question(points: 1)[
  #true-false(answer: true)[The cell membrane controls which substances enter and leave the cell.]
]

#question(points: 1)[
  #true-false(answer: false)[Osmosis is the movement of solute particles from a low to a high concentration.]
  #answer[False. Osmosis is the movement of _water_ across a partially permeable membrane, from a dilute solution to a more concentrated one.]
]

#question(points: 1)[
  #true-false(answer: true)[Prokaryotic cells, such as bacteria, do not have a nucleus.]
]

#question(points: 1)[
  #true-false(answer: false)[Diffusion needs energy from ATP.]
  #answer[False. Diffusion is passive: particles move down a concentration gradient without using energy.]
]

#question(points: 1)[
  #true-false(answer: true)[A mature plant cell usually has a large central vacuole that stores water and helps support the cell.]
]

#question(points: 1)[
  #true-false(answer: true)[New cells are produced from existing cells by cell division.]
]

#question(points: 1)[
  #true-false(answer: false)[Mitosis produces four cells that are genetically different from the parent cell.]
  #answer[False. Mitosis produces two cells that are genetically identical to the parent cell.]
]

#answer-key()