{
  "name": "@typstream/node",
  "version": "0.0.0",
  "description": "Server-side Typst for typstream: validate and render documents, repair them with an LLM, and serve the engine protocol over WebSocket.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/node"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/node",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "llm",
    "validation",
    "server"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/copy-fonts.mjs",
    "test": "vitest run",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@typstream/core": "workspace:*",
    "@typstream/docx": "workspace:*",
    "@typstream/engine": "workspace:*",
    "@typstream/engine-wasm": "workspace:*",
    "@typstream/heal": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "@typstream/corpus": "workspace:*",
    "fflate": "0.8.3",
    "ws": "^8.22.0"
  }
}
