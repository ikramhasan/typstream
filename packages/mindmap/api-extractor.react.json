{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "../../tools/repo/api-extractor.base.json",
  // The `@typstream/mindmap/react` entry point: the interactive map.
  "mainEntryPointFilePath": "<projectFolder>/dist/react.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFileName": "mindmap-react.api.md",
    "reportFolder": "<projectFolder>/api/",
    "reportTempFolder": "<projectFolder>/dist/api/"
  },
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true
      },
      "files": ["dist/react.d.ts"]
    }
  }
}
