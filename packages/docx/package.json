{
  "name": "@typstream/docx",
  "version": "0.0.0",
  "description": "DOCX export for typstream: a laid-out Typst document as editable Word, line and page breaks kept.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/docx"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/docx",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "docx",
    "word",
    "ooxml"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
