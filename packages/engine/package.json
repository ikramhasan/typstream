{
  "name": "@typstream/engine",
  "version": "0.0.0",
  "description": "Compiles streamed Typst in a worker: heals on the main thread, schedules compiles, and recovers from runaway documents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/engine"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/engine",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "streaming",
    "llm",
    "wasm",
    "web-worker"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "default": "./dist/websocket.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./worker": "./dist/worker.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project node",
    "size": "node scripts/size.mjs",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run && api-extractor run -c api-extractor.server.json && api-extractor run -c api-extractor.websocket.json && api-extractor run -c api-extractor.images.json",
    "api:update": "api-extractor run --local && api-extractor run --local -c api-extractor.server.json && api-extractor run --local -c api-extractor.websocket.json && api-extractor run --local -c api-extractor.images.json",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@typstream/core": "workspace:*",
    "@typstream/docx": "workspace:*",
    "@typstream/engine-wasm": "workspace:*",
    "@typstream/heal": "workspace:*"
  },
  "devDependencies": {
    "@typstream/corpus": "workspace:*",
    "@typstream/universe": "workspace:*",
    "@vitest/browser-playwright": "4.1.12",
    "fflate": "0.8.3",
    "playwright": "^1.64.1"
  }
}
