{
  "name": "@typstream/google-fonts",
  "version": "0.0.0",
  "description": "Any family of the Google Fonts library in typstream documents, by name: a font catalogue the engine loads families from on demand, in both render targets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/google-fonts"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/google-fonts",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "google-fonts",
    "fonts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalogue.json": "./catalogue.json"
  },
  "files": [
    "dist",
    "catalogue.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "catalogue": "node scripts/catalogue.mjs",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./catalogue.json"
  },
  "dependencies": {
    "@typstream/core": "workspace:*"
  },
  "devDependencies": {
    "@typstream/engine-wasm": "workspace:*"
  }
}
