{
  "name": "@typstream/heal",
  "version": "0.0.0",
  "description": "Self-healing for streamed Typst: closes and trims incomplete syntax so every prefix compiles.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:long": "HEAL_PROPERTY_RUNS=20000 vitest run __tests__/properties.test.ts",
    "bench": "vitest bench --run",
    "size": "node scripts/size.mjs",
    "check-types": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@typstream/core": "workspace:*"
  },
  "devDependencies": {
    "@typstream/corpus": "workspace:*"
  }
}
