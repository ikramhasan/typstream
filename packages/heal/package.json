{
  "name": "@typstream/heal",
  "version": "0.0.0",
  "description": "Self-healing for streamed Typst: closes and trims incomplete syntax so every prefix compiles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/heal"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/heal",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "streaming",
    "llm",
    "parser"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:long": "HEAL_PROPERTY_RUNS=20000 vitest run __tests__/properties.test.ts",
    "mutate": "HEAL_PROPERTY_RUNS=10 HEAL_PROPERTY_SEED=1 HEAL_RESYNC_KB=10 stryker run",
    "bench": "vitest bench --run",
    "size": "node scripts/size.mjs",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@typstream/core": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@typstream/corpus": "workspace:*"
  }
}
