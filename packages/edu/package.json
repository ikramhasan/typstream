{
  "name": "@typstream/edu",
  "version": "0.0.0",
  "description": "Typst functions and templates for teachers' documents (questions, answer spaces and keys, callouts, rubrics, drawings, chemistry), as a typstream plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/edu"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/edu",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "education",
    "worksheet",
    "quiz",
    "llm"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./edu.css": "./css/edu.css",
    "./typst/*": "./typst/*"
  },
  "files": [
    "dist",
    "typst",
    "css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/embed.mjs && tsup",
    "embed": "node scripts/embed.mjs",
    "test": "vitest run --project node",
    "test:paged": "vitest run --project paged",
    "test:docx": "vitest run --project docx",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./edu.css"
  },
  "dependencies": {
    "@typstream/core": "workspace:*"
  },
  "devDependencies": {
    "@typstream/engine-wasm": "workspace:*",
    "@typstream/html-compat": "workspace:*"
  }
}
