{
  "name": "@typstream/engine-wasm",
  "version": "0.0.0",
  "description": "Typst 0.15.1 compiled to wasm: in-memory files and fonts, HTML, changed-page SVG and PDF, structured diagnostics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/engine-wasm"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/engine-wasm",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "wasm",
    "pdf",
    "svg"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm.js"
    },
    "./engine_bg.wasm": "./dist/engine_bg.wasm",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist",
    "!dist/.inputs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "./build.sh",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./engine_bg.wasm ./fonts/*"
  }
}
