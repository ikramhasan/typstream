{
  "name": "@typstream/editor-core",
  "version": "0.0.0",
  "description": "A visual editor for Typst on its own pages: caret, selection and commands over the engine's layout, every change a minimal edit of the source.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "size": "node scripts/size.mjs",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@typstream/core": "workspace:*",
    "@typstream/dom": "workspace:*",
    "@typstream/engine": "workspace:*",
    "@typstream/syntax": "workspace:*"
  },
  "devDependencies": {
    "@typstream/corpus": "workspace:*",
    "@typstream/edu": "workspace:*",
    "@typstream/engine-wasm": "workspace:*",
    "@typstream/mindmap": "workspace:*",
    "@vitest/browser-playwright": "4.1.12",
    "playwright": "^1.64.1"
  }
}
