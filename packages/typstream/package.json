{
  "name": "typstream",
  "version": "0.0.0",
  "description": "Render Typst streamed from an LLM, live, in React: import { Typstream } from \"typstream\".",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/typstream"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/typstream",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "streaming",
    "llm",
    "react",
    "ai"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@typstream/engine": "workspace:*",
    "@typstream/engine-wasm": "workspace:*",
    "@typstream/heal": "workspace:*",
    "@typstream/html-compat": "workspace:*",
    "@typstream/react": "workspace:*",
    "@typstream/universe": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  }
}
