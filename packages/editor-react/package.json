{
  "name": "@typstream/editor-react",
  "version": "0.0.0",
  "description": "The typstream editor for React: Typst documents edited on their own pages, with fixed and floating toolbars, menus and forms for components.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "size": "node scripts/size.mjs",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@typstream/core": "workspace:*",
    "@typstream/dom": "workspace:*",
    "@typstream/editor-core": "workspace:*",
    "@typstream/engine": "workspace:*",
    "@typstream/react": "workspace:*",
    "@typstream/syntax": "workspace:*",
    "lucide-react": "^1.61.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typstream/edu": "workspace:*",
    "@typstream/engine-wasm": "workspace:*",
    "@typstream/html-compat": "workspace:*",
    "@typstream/mindmap": "workspace:*",
    "@vitest/browser-playwright": "4.1.12",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
