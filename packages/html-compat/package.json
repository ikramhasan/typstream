{
  "name": "@typstream/html-compat",
  "version": "0.0.0",
  "description": "A Typst prelude and CSS that make Typst's HTML export keep the content of layout elements it would drop (grid, align, place, shapes, …).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/html-compat"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/html-compat",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "html"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./html-compat.typ": "./typst/html-compat.typ",
    "./html-compat.css": "./css/html-compat.css"
  },
  "files": [
    "dist",
    "typst",
    "css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/embed.mjs && tsup",
    "embed": "node scripts/embed.mjs",
    "test": "vitest run",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./html-compat.typ ./html-compat.css"
  },
  "dependencies": {
    "@typstream/core": "workspace:*"
  },
  "devDependencies": {
    "@typstream/corpus": "workspace:*",
    "@typstream/engine-wasm": "workspace:*",
    "@typstream/universe": "workspace:*",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299"
  }
}
