{
  "name": "@typstream/ai",
  "version": "0.0.0",
  "description": "typstream with AI SDKs: an AI SDK chat's assistant messages as Typst documents, streaming or finished.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramhasan/typstream.git",
    "directory": "packages/ai"
  },
  "homepage": "https://typstream.vercel.app/docs/reference/ai",
  "bugs": "https://github.com/ikramhasan/typstream/issues",
  "keywords": [
    "typst",
    "ai-sdk",
    "llm",
    "streaming"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "check-types": "tsc -p tsconfig.json",
    "check:api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@typstream/core": "workspace:*",
    "@typstream/heal": "workspace:*"
  },
  "devDependencies": {
    "@typstream/corpus": "workspace:*",
    "ai": "^7.0.153"
  }
}
