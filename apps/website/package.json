{
  "name": "@typstream/website",
  "version": "0.0.0",
  "description": "typstream's website: landing page and documentation (Next.js + Fumadocs, PLAN.md \u00a710.5), with llms.txt and a markdown version of every page.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && next dev",
    "build": "node scripts/generate.mjs && next build",
    "start": "next start",
    "test": "node scripts/check-docs.mjs",
    "check-types": "node scripts/generate.mjs && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@typstream/core": "workspace:*",
    "@typstream/edu": "workspace:*",
    "@typstream/heal": "workspace:*",
    "@typstream/mindmap": "workspace:*",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "lucide-react": "1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typstream": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-typescript": "^5.6.0",
    "github-slugger": "^2.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  }
}
