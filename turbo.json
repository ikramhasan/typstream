{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["^build"], "env": ["BROWSERS"] },
    "bench": { "dependsOn": ["^build"], "cache": false },
    "size": { "dependsOn": ["build"], "cache": false },
    "check-types": { "dependsOn": ["^build"] },
    "check:api": { "dependsOn": ["build"] },
    "api:update": { "dependsOn": ["build"], "cache": false },
    "check:package": { "dependsOn": ["build"] }
  }
}
