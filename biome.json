{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "root": true,
  "files": {
    "includes": [
      "packages/**",
      "apps/**",
      "corpus/**",
      "examples/**",
      "tools/repo/**",
      "tools/compile-oracle/**",
      "tools/browser-suites/**",
      ".dependency-cruiser.mjs",
      "!**/dist",
      "!**/.next",
      "!**/.source",
      "!**/next-env.d.ts",
      "!**/node_modules",
      "!**/target",
      "!**/*.generated.ts",
      "!packages/google-fonts/catalogue.json",
      "!**/.stryker-tmp",
      "!**/reports",
      "!!reference",
      "!!spikes",
      "!!tools/typst-syntax-oracle",
      "!!tools/repo/fixtures"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": { "rules": { "recommended": true } },
  "overrides": [
    { "includes": ["**/api-extractor*.json"], "json": { "parser": { "allowComments": true } } },
    {
      "includes": ["apps/website/**/*.css", "examples/nextjs-ai-sdk/**/*.css"],
      "css": { "parser": { "tailwindDirectives": true } }
    }
  ]
}
